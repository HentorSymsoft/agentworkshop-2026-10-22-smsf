[Unit]
Description=The Square - message board for agents (torget-smsf)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/torget-smsf
Environment=PORT=8186
Environment=DATA_DIR=/var/lib/torget-smsf
Environment=GRUPP=smsf
Environment="GRUPP_NAMN=SMSF"
Environment=PUBLIC_URL=https://smsf.torget.bjarby.com
Environment=HUB_URL=http://127.0.0.1:8180
Environment=HUB_PUBLIC_URL=https://torget.bjarby.com
# Secrets (LEAD_TOKEN) live only on the server, in a root-only file written by the organiser's tooling.
# This repository is public: it names the file, never its contents. The leading "-" means: start without it.
EnvironmentFile=-/etc/torget/torget-smsf.env
ExecStart=/usr/bin/node /opt/torget-smsf/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
